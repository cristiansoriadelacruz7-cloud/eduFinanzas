# Copia este archivo como .env y ajusta los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta de sesiones (genera una larga y aleatoria para producción)
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos. En local puedes dejarlo vacío y usará tu MySQL local.
# En la nube pega la URL completa que te dé tu proveedor, por ejemplo:
# DATABASE_URL=mysql+pymysql://usuario:contrasena@host:3306/bd?charset=utf8mb4
DATABASE_URL=

# Modo depuración (déjalo false en producción)
FLASK_DEBUG=false

# Login con Google (Google Identity Services)
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crear credenciales -> ID de cliente de OAuth -> Aplicación web
# 3. En "Orígenes autorizados" agrega http://localhost:5000 (y tu dominio en producción)
# 4. Copia el CLIENT ID aquí y en tu .env
GOOGLE_CLIENT_ID=tu-client-id-de-google.apps.googleusercontent.com
