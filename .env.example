# Copia este archivo como .env y ajusta los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta de sesiones (genera una larga y aleatoria para producción)
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos. En local puedes dejarlo vacío y usará tu MySQL local.
# En la nube pega la URL completa que te dé tu proveedor, por ejemplo:
# DATABASE_URL=mysql+pymysql://usuario:contrasena@host:3306/bd?charset=utf8mb4
DATABASE_URL=

# Modo depuración (déjalo false en producción)
FLASK_DEBUG=false
